# Copy to .env before running `docker compose up`.
# docker compose reads .env automatically; the file is git-ignored.

# SQL Server SA password for the local container. Choose your own: at least eight characters
# from three of uppercase, lowercase, digits and symbols. Compose refuses to start while it is empty.
MSSQL_SA_PASSWORD=

# JSON Web Token (JWT) signing key. At least 32 characters — JwtOptions validates this on start.
JWT_SIGNING_KEY=change-me-to-a-random-value-min-32-chars

JWT_ISSUER=sportsbetting-api
JWT_AUDIENCE=sportsbetting-clients
JWT_EXPIRATION_MINUTES=60

# API-Football. Leave the key empty to serve the offline sample fixtures (1001 to 1005), which
# is enough to run the whole deposit, fixtures and bet flow locally.
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=
# Set to true to serve the offline fixtures even when a key is set.
FOOTBALL_API_USE_OFFLINE_FIXTURES=false
FOOTBALL_API_CACHE_SECONDS=30
# Maximum time for a request to API-Football, in seconds.
FOOTBALL_API_TIMEOUT_SECONDS=10
# Fixed league season the fixture list reads: La Liga (140), season 2024. Odds are not fetched.
FOOTBALL_API_SEASON=2024
FOOTBALL_API_LEAGUE_ID=140

ASPNETCORE_ENVIRONMENT=Development

# Host ports published by docker compose.
API_HOST_PORT=8080
SQLSERVER_HOST_PORT=1434
