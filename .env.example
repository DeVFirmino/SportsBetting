# Copy to .env before running `docker compose up`.
# docker compose reads .env automatically; the file is git-ignored.

# SQL Server SA password. Must satisfy the SQL Server password policy.
MSSQL_SA_PASSWORD=YourStrongPassword123!

# JSON Web Token (JWT) signing key. At least 32 characters — JwtOptions validates this on start.
JWT_SIGNING_KEY=change-me-to-a-random-value-min-32-chars
JWT_ISSUER=sportsbetting-api
JWT_AUDIENCE=sportsbetting-clients
JWT_EXPIRATION_MINUTES=60

# API-Football credentials.
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=your-api-football-key
FOOTBALL_API_CACHE_SECONDS=30
# Base backoff between retries against API-Football, in milliseconds.
FOOTBALL_API_RETRY_DELAY_MS=500

ASPNETCORE_ENVIRONMENT=Development

# Host ports published by docker compose.
API_HOST_PORT=8080
SQLSERVER_HOST_PORT=1434
